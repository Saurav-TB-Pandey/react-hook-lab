{
  "name": "react-hook-lab",
  "version": "1.11.0",
  "description": "A lightweight collection of reusable React hooks for async operations, browser APIs, DOM observers, state management, timers, and utilities. Built with TypeScript.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "require": "./dist/utils.js",
      "default": "./dist/utils.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.js",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "prepublishOnly": "npm run validate",
    "validate": "npm run format && npm run lint && npm run typecheck && npm test && npm run build",
    "pack:dry-run": "npm pack --dry-run",
    "auth:google": "npx kill-port 3000 && node scripts/auth/get-google-token.js",
    "auth:linkedin": "npx kill-port 3000 && node scripts/auth/get-linkedin-token.js",
    "publish:article": "node scripts/publish-article.js",
    "update:secret": "node scripts/auth/update-github-secret.js",
    "delete:branch": "node scripts/delete-branch.js",
    "check-milestone": "node scripts/check-milestone.js",
    "publish:daily-term": "node scripts/daily-tech-term.js"
  },
  "keywords": [
    "react",
    "react-hook",
    "react-hooks",
    "hook-library",
    "react-library",
    "typescript",
    "typescript-hooks",
    "custom-hooks",
    "usehooks",
    "useFullscreen",
    "useURL",
    "useResource",
    "useAsync",
    "useAsyncDebounce",
    "useDebounce",
    "useThrottle",
    "useClipboard",
    "useDownload",
    "useLocalStorage",
    "useNotifications",
    "useOnlineStatus",
    "useSessionStorage",
    "useCamera",
    "useMicrophone",
    "useLocation",
    "useIdle",
    "useTimezone",
    "useClickOutside",
    "useElementSize",
    "useIntersectionObserver",
    "useResizeObserver",
    "useWidth",
    "useBoolean",
    "useCounter",
    "usePrevious",
    "useSharedState",
    "useToggle",
    "useIndexedDB",
    "createIndexedDB",
    "useFileSystem",
    "usePip",
    "picture-in-picture",
    "indexeddb",
    "broadcastchannel",
    "useDeepClone",
    "useDeepMemo",
    "useInterval",
    "useTimeout",
    "useRenderReason",
    "deepClone",
    "deepEqual",
    "performance",
    "render-diagnostics",
    "state-management",
    "timer",
    "browser",
    "dom"
  ],
  "author": {
    "name": "Saurav_TB_Pandey",
    "url": "https://sauravtbpandey.blogspot.com/"
  },
  "funding": {
    "type": "buy-me-a-coffee",
    "url": "https://www.buymeacoffee.com/saurav_tb_pandey"
  },
  "socials": {
    "linkedin": "https://www.linkedin.com/in/pandeysaurav/",
    "devto": "https://dev.to/saurav_tb_pandey"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Saurav-TB-Pandey/react-hook-lab.git",
    "directory": "."
  },
  "bugs": {
    "url": "https://github.com/Saurav-TB-Pandey/react-hook-lab/issues"
  },
  "homepage": "https://github.com/Saurav-TB-Pandey/react-hook-lab#readme",
  "documentation": "https://github.com/Saurav-TB-Pandey/react-hook-lab/wiki",
  "engines": {
    "node": ">=16"
  },
  "packageManager": "npm@10",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "react": "^16.8 || ^17 || ^18 || ^19",
    "react-dom": "^16.8 || ^17 || ^18 || ^19"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.1",
    "@types/react-test-renderer": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-test-renderer": "^18.3.1",
    "typescript": "^5.6.3"
  }
}
